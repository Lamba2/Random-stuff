# Bot token from https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=

# Optional: your server's ID. Commands show up there instantly instead of being registered globally.
# (Discord: Settings → Advanced → Developer Mode, then right-click the server → Copy Server ID)
GUILD_ID=

# Optional: embed accent color as hex
EMBED_COLOR=#5865F2

# Optional: where data is saved (default: data/store.json)
DATA_FILE=
